# Copie para `.env` (ignorado pelo git) e preencha. O Docker Compose lê este
# arquivo automaticamente na raiz do projeto. Nenhum valor real entra no git.

# --- Dev local (compose.yaml) ---
SAQZ_BACKEND_PORT=8080
SAQZ_MAILPIT_UI_PORT=8025
# Origens liberadas para o adm-web. Vazio = nada liberado.
SAQZ_ADMINWEB_ORIGINS=

# --- Servidor (compose.server.yaml) ---
SAQZ_DB_PASSWORD=
SAQZ_ASAAS_API_KEY=
SAQZ_ASAAS_WEBHOOK_TOKEN=
# Sandbox por default; producao usa https://api.asaas.com/v3
SAQZ_ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# usuario:senha do Mailpit publicado. Obrigatorio subir o overlay do servidor.
SAQZ_MAILPIT_AUTH=
# HMAC dos codigos de recuperacao. Sem default na aplicacao de proposito.
SAQZ_PASSWORD_RESET_SECRET=

# --- WhatsApp (Uazapi) ---
# Desabilitado por padrao: sem `enabled=true` nenhum bean de WhatsApp sobe.
SAQZ_NOTIFICATIONS_WHATSAPP_ENABLED=false
SAQZ_NOTIFICATIONS_WHATSAPP_BASEURL=https://saqzapp.uazapi.com
SAQZ_NOTIFICATIONS_WHATSAPP_TOKEN=
SAQZ_NOTIFICATIONS_WHATSAPP_DELAYMS=15000

# --- Lembrete automatico de presenca (confirmados/lista de espera/fora/a confirmar) ---
# Teste: 60000 = 1 por minuto. Migrar para 21600000 (6h) quando validado.
SAQZ_NOTIFICATIONS_REMINDER_ENABLED=true
SAQZ_NOTIFICATIONS_REMINDER_DELAY_MS=60000
