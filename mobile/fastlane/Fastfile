# Lanes chamadas pelo workflow mobile-rc.yml (a publicação em produção é mobile/ci/publish_stores.py). Os segredos chegam por
# variável de ambiente (Environment "mobile" do GitHub); nada aqui lê segredo do repositório.
#
#   SAQZ_VERSION_NAME / SAQZ_VERSION_CODE   versão X.Y.Z e build inteiro, os mesmos que ci/version.sh gravou
#   SAQZ_RELEASE_NOTES                      notas da RC: "O que testar" no TestFlight, changelog no Play,
#                                           "Novidades" na App Store
#   SAQZ_AAB_PATH                           AAB prod assinado, gerado pelo workflow com bundleProdRelease
#   SAQZ_IPA_PATH                           IPA gerado pela lane ios archive (só a lane ios upload lê)
#   PLAY_SERVICE_ACCOUNT_JSON               conteúdo do JSON da conta de serviço do Play
#   ASC_ISSUER_ID / ASC_KEY_ID / ASC_KEY_P8 chave da App Store Connect API (o .p8 inteiro em ASC_KEY_P8)
#   IOS_DIST_CERT_P12 / IOS_DIST_CERT_PASSWORD   certificado Apple Distribution fixo (.p12 em base64) e a senha dele
#   IOS_PROFILE_APP / IOS_PROFILE_LIVEACTIVITY   perfis App Store de app.saqz e app.saqz.LiveActivity (base64)

require "base64"
require "securerandom"

opt_out_usage
skip_docs

MOBILE_ROOT = File.expand_path("..", __dir__)
IOS_PROJECT = File.join(MOBILE_ROOT, "ios-app", "SaqzIOS.xcodeproj")
IOS_SCHEME = "SaqzProd"
TEAM_ID = "8JG4JP8VMT"
APP_ID = "app.saqz"
LIVE_ACTIVITY_ID = "app.saqz.LiveActivity"
SIGNING_IDENTITY = "iPhone Distribution"
LOCALE = "pt-BR"
PLAY_CHANGELOG_LIMIT = 500 # limite do Play para o texto de uma release

def required_env(name)
  value = ENV.fetch(name, "").strip
  UI.user_error!("Falta a variável de ambiente #{name}") if value.empty?
  value
end

def release_version
  version = required_env("SAQZ_VERSION_NAME")
  build = required_env("SAQZ_VERSION_CODE")
  UI.user_error!("SAQZ_VERSION_NAME deve ser X.Y.Z (recebi '#{version}')") unless version.match?(/\A\d+\.\d+\.\d+\z/)
  UI.user_error!("SAQZ_VERSION_CODE deve ser inteiro (recebi '#{build}')") unless build.match?(/\A\d+\z/)
  [version, build.to_i]
end

def release_notes
  required_env("SAQZ_RELEASE_NOTES")
end

# Registra a chave da App Store Connect para o pilot (upload ao TestFlight). Não assina nada: a assinatura é manual,
# com o certificado e os perfis fixos do Environment (ver with_signing).
def connect_to_app_store
  key_id = required_env("ASC_KEY_ID")
  issuer_id = required_env("ASC_ISSUER_ID")
  key_path = File.join(Dir.tmpdir, "AuthKey_#{key_id}.p8")
  File.write(key_path, required_env("ASC_KEY_P8"), perm: 0o600)
  app_store_connect_api_key(key_id: key_id, issuer_id: issuer_id, key_filepath: key_path, in_house: false)
end

def decode_to_file(env_name, path)
  File.binwrite(path, Base64.decode64(required_env(env_name)))
  path
end

# Instala o perfil .mobileprovision no lugar onde o xcodebuild o procura e devolve o nome dele.
def install_profile(env_name, dir)
  file = decode_to_file(env_name, File.join(dir, "#{env_name}.mobileprovision"))
  plist = `security cms -D -i "#{file}"`
  UI.user_error!("Perfil #{env_name} inválido") unless $?.success?
  uuid = plist[%r{<key>UUID</key>\s*<string>([^<]+)</string>}, 1]
  name = plist[%r{<key>Name</key>\s*<string>([^<]+)</string>}, 1]
  UI.user_error!("Perfil #{env_name} sem UUID ou nome") if uuid.nil? || name.nil?
  target_dir = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
  FileUtils.mkdir_p(target_dir)
  FileUtils.cp(file, File.join(target_dir, "#{uuid}.mobileprovision"))
  name
end

# Chaveiro temporário com o certificado Apple Distribution fixo e os dois perfis App Store; apagado no fim.
# Substitui a assinatura automática na nuvem, que a cada execução criava um certificado de desenvolvimento novo
# no runner e estourou o limite da conta (RC 1.0.10, 20/10/2026). Devolve ao bloco os nomes dos perfis.
def with_signing
  dir = Dir.mktmpdir("ios-signing")
  keychain = "saqz-ci-#{Process.pid}.keychain"
  password = SecureRandom.hex(24)
  profiles = {
    APP_ID => install_profile("IOS_PROFILE_APP", dir),
    LIVE_ACTIVITY_ID => install_profile("IOS_PROFILE_LIVEACTIVITY", dir),
  }
  create_keychain(name: keychain, password: password, default_keychain: false, unlock: true, timeout: 7200,
                  lock_when_sleeps: false)
  import_certificate(
    certificate_path: decode_to_file("IOS_DIST_CERT_P12", File.join(dir, "dist.p12")),
    certificate_password: required_env("IOS_DIST_CERT_PASSWORD"),
    keychain_name: keychain,
    keychain_password: password,
    log_output: false,
  )
  yield profiles
ensure
  delete_keychain(name: keychain) if keychain && File.exist?(File.expand_path("~/Library/Keychains/#{keychain}-db"))
  FileUtils.rm_rf(dir) if dir
end

def play_options
  {
    package_name: APP_ID,
    json_key_data: required_env("PLAY_SERVICE_ACCOUNT_JSON"),
    skip_upload_metadata: true,
    skip_upload_images: true,
    skip_upload_screenshots: true,
  }
end

platform :android do
  desc "Envia o AAB prod (SAQZ_AAB_PATH) para a trilha interna do Play, já liberado para os testadores"
  lane :internal do
    version, build = release_version
    aab = required_env("SAQZ_AAB_PATH")
    UI.user_error!("AAB não encontrado: #{aab}") unless File.file?(aab)

    # O changelog do Play vem de <metadata_path>/<locale>/changelogs/<build>.txt; monta fora do repositório.
    metadata = Dir.mktmpdir("play-metadata")
    changelog_dir = File.join(metadata, LOCALE, "changelogs")
    FileUtils.mkdir_p(changelog_dir)
    File.write(File.join(changelog_dir, "#{build}.txt"), release_notes[0, PLAY_CHANGELOG_LIMIT])

    supply(
      **play_options,
      track: "internal",
      aab: aab,
      skip_upload_apk: true,
      release_status: "completed",
      version_name: "#{build} (#{version})",
      metadata_path: metadata,
      skip_upload_changelogs: false,
    )
  end
end

platform :ios do
  desc "Arquiva o scheme SaqzProd com assinatura manual (certificado e perfis fixos) e gera o IPA em build/ios (sem enviar)"
  lane :archive do
    version, build = release_version
    output_dir = File.join(MOBILE_ROOT, "build", "ios")

    with_signing do |profiles|
      # Assinatura manual por target: o projeto está em Automatic para o desenvolvimento local, e só o runner muda.
      { "SaqzIOS" => APP_ID, "SaqzLiveActivity" => LIVE_ACTIVITY_ID }.each do |target, bundle_id|
        update_code_signing_settings(
          use_automatic_signing: false,
          path: IOS_PROJECT,
          targets: [target],
          build_configurations: ["Release"],
          team_id: TEAM_ID,
          code_signing_identity: SIGNING_IDENTITY,
          profile_name: profiles.fetch(bundle_id),
          bundle_identifier: bundle_id,
        )
      end

      gym(
        project: IOS_PROJECT,
        scheme: IOS_SCHEME,
        configuration: "Release",
        export_method: "app-store",
        export_options: {
          signingStyle: "manual",
          teamID: TEAM_ID,
          signingCertificate: SIGNING_IDENTITY,
          provisioningProfiles: profiles,
          uploadSymbols: true,
        },
        # A versão já está no pbxproj (ci/version.sh), mas o override garante o mesmo número em qualquer checkout.
        xcargs: "MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build}",
        output_directory: output_dir,
        output_name: "Saqz.ipa",
        buildlog_path: File.join(output_dir, "logs"),
        disable_package_automatic_updates: true,
      )
    end
  end

  desc "Envia o IPA (SAQZ_IPA_PATH, ou o da lane archive) ao TestFlight para os testadores internos"
  lane :upload do
    version, build = release_version
    notes = release_notes
    connect_to_app_store
    ipa = ENV.fetch("SAQZ_IPA_PATH", "").strip
    ipa = lane_context[SharedValues::IPA_OUTPUT_PATH] if ipa.empty?
    UI.user_error!("IPA não encontrado: #{ipa}") unless ipa && File.file?(ipa)

    pilot(
      app_identifier: APP_ID,
      ipa: ipa,
      app_version: version,
      build_number: build.to_s,
      changelog: notes,
      distribute_external: false,
      notify_external_testers: false,
      skip_waiting_for_build_processing: false,
      wait_processing_timeout_duration: 2700,
    )
  end

  desc "Arquiva e envia ao TestFlight numa tacada só (uso local)"
  lane :testflight do
    archive
    upload
  end
end
