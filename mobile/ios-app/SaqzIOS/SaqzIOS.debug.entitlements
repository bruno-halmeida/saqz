<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Debug usa APNs sandbox; a Release usa producao (SaqzIOS.entitlements).
         Associated Domains e a mesma nos dois: o host dos links e publico
         (links.saqz.app) e nao tem par test/live. -->
    <key>aps-environment</key>
    <string>development</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:$(BRANCH_DOMAIN)</string>
	</array>
</dict>
</plist>
