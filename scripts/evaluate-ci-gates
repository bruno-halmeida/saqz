#!/bin/sh
set -eu

[ "$#" -eq 4 ] || {
    printf 'usage: %s scripts-result backend-result mobile-result landing-result\n' "$0" >&2
    exit 2
}

# skipped é sucesso: os gates de PR são path-filtered (VUL-23) — um gate pulado
# significa que o workspace dele não foi tocado, não que algo falhou.
for result in "$@"; do
    case "$result" in
        success|skipped) ;;
        *)
            printf 'initialization gate failed: expected success or skipped, got %s\n' "${result:-<empty>}" >&2
            exit 1
            ;;
    esac
done

printf 'ok - initialization gate\n'
