#!/bin/sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
mobile_root="$repository_root/mobile"

fail() {
    printf 'mobile boundary gate failed: %s\n' "$1" >&2
    exit 1
}

tracked_mobile_files() {
    git -C "$repository_root" ls-files -- 'mobile' | while IFS= read -r file; do
        [ -e "$repository_root/$file" ] && printf '%s\n' "$file"
    done
}

# features - nomes de feature descobertos no disco, um por linha. VUL-37: a lista era
# hardcoded no par access/groups e o cross-check assumia que as duas tinham
# apresentação. Pós-onda C só `access` tem `ui/`; o módulo raiz de `groups` guarda
# contratos e ports nativos. Descobrir a lista mantém o gate correto para qualquer
# número de features e dispensa reescrita quando uma nasce ou morre.
features() {
    find "$mobile_root/features" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort
}

# extract_common_main FILE - print the body of the commonMain.dependencies { ... }
# block. The repository's build files never nest braces inside that block, so a
# marker-to-first-closing-brace scan is sufficient and avoids a full Groovy/KTS parser.
extract_common_main() {
    awk '
        /commonMain\.dependencies[[:space:]]*\{/ { found=1; next }
        found && /^[[:space:]]*\}[[:space:]]*$/ { found=0; next }
        found { print }
    ' "$1"
}

# check_domain_allowlist LABEL FILE - every non-blank dependency line must be exactly the
# shared-kernel dependency; anything else (Compose, Koin, Ktor, serialization, a sibling
# feature, its own data/presentation) is rejected by construction.
check_domain_allowlist() {
    module_label=$1
    file=$2
    [ -f "$file" ] || return 0
    violation=$(extract_common_main "$file" | grep -Ev '^[[:space:]]*$' | grep -Ev '^[[:space:]]*implementation\(project\(":core:domain"\)\)[[:space:]]*$' || true)
    [ -z "$violation" ] || {
        printf '%s\n' "$violation" >&2
        fail "$module_label domain module depends on more than :core:domain in $file"
    }
}

# check_denylist FILE LABEL PATTERN - fail if any commonMain dependency line matches
# the forbidden pattern; the diagnostic names both the file and the offending line.
check_denylist() {
    file=$1
    label=$2
    pattern=$3
    [ -f "$file" ] || return 0
    matches=$(extract_common_main "$file" | grep -E "$pattern" || true)
    [ -z "$matches" ] || {
        printf '%s\n' "$matches" >&2
        fail "$label in $file"
    }
}

# reject_sibling_feature_projects FILE LABEL FEATURE - nenhuma feature depende de outra,
# seja pela raiz, pelo domain ou pelo data da vizinha.
reject_sibling_feature_projects() {
    file=$1
    label=$2
    feature=$3
    for other in $(features); do
        [ "$other" = "$feature" ] && continue
        check_denylist "$file" "$label" "\":features:$other[\":]"
    done
}

check_feature_root_build() {
    feature=$1
    file="$mobile_root/features/$feature/build.gradle.kts"
    check_denylist "$file" "presentation depends on its own data module" "\":features:$feature:data\""
    check_denylist "$file" "presentation depends on core:network" '":core:network"'
    check_denylist "$file" "presentation depends on Ktor" 'io\.ktor|libs\.ktor'
    reject_sibling_feature_projects "$file" "presentation depends on the other feature" "$feature"
}

check_data_build() {
    feature=$1
    file="$mobile_root/features/$feature/data/build.gradle.kts"
    check_denylist "$file" "data module depends on its own presentation module" "\":features:$feature\"\\)"
    reject_sibling_feature_projects "$file" "data module depends on the other feature" "$feature"
}

# --- Source import scans ----------------------------------------------------

# reject_source_imports LABEL DIR_PATTERN IMPORT_PATTERN
reject_source_imports() {
    label=$1
    dir_pattern=$2
    import_pattern=$3
    files=$(tracked_mobile_files | grep -E "$dir_pattern" | grep -E '\.kt$' || true)
    [ -n "$files" ] || return 0
    matches=$(printf '%s\n' "$files" | sed "s#^#$repository_root/#" | xargs grep -InE "$import_pattern" 2>/dev/null || true)
    [ -z "$matches" ] || {
        printf '%s\n' "$matches" >&2
        fail "$label"
    }
}

# reject_sibling_feature_imports LABEL DIR_PATTERN FEATURE - o pacote de cada feature é
# `br.com.saqz.<feature>`, então a lista de vizinhas sai da mesma descoberta de disco.
reject_sibling_feature_imports() {
    label=$1
    dir_pattern=$2
    feature=$3
    for other in $(features); do
        [ "$other" = "$feature" ] && continue
        reject_source_imports "$label" "$dir_pattern" "import br\\.com\\.saqz\\.$other\\."
    done
}

# --- Shared kernel ----------------------------------------------------------

check_domain_allowlist 'core' "$mobile_root/core/domain/build.gradle.kts"
reject_source_imports 'core domain imports a framework' \
    '^mobile/core/domain/src/' 'import (androidx\.|org\.koin\.|io\.ktor\.|kotlinx\.serialization)'

# --- Per-feature boundaries -------------------------------------------------

for feature in $(features); do
    check_domain_allowlist "$feature" "$mobile_root/features/$feature/domain/build.gradle.kts"
    check_feature_root_build "$feature"
    check_data_build "$feature"

    # Módulo raiz (apresentação onde ela existe, contratos e ports onde não): rejeita a
    # própria camada de dados, a rede, o motor de serialização e as vizinhas.
    reject_source_imports "$feature presentation imports its own data layer" \
        "^mobile/features/$feature/src/" "import br\\.com\\.saqz\\.$feature\\.data\\."
    reject_source_imports "$feature presentation imports core network" \
        "^mobile/features/$feature/src/" 'import br\.com\.saqz\.network\.'
    reject_source_imports "$feature presentation imports the serialization transport engine" \
        "^mobile/features/$feature/src/(commonMain|androidMain|iosMain|appleMain|nativeMain)/" \
        'import kotlinx\.serialization\.json'
    reject_sibling_feature_imports "$feature presentation imports the other feature" \
        "^mobile/features/$feature/src/" "$feature"

    # Domain: puro. Sem framework, sem vizinha.
    reject_source_imports "$feature domain imports a framework" \
        "^mobile/features/$feature/domain/src/" 'import (androidx\.|org\.koin\.|io\.ktor\.|kotlinx\.serialization)'
    reject_sibling_feature_imports "$feature domain imports the other feature" \
        "^mobile/features/$feature/domain/src/" "$feature"

    # Data: não sobe para apresentação, não atravessa para a vizinha.
    reject_source_imports "$feature data imports its own presentation" \
        "^mobile/features/$feature/data/src/" "import br\\.com\\.saqz\\.$feature\\.(presentation|ui)\\."
    reject_sibling_feature_imports "$feature data imports the other feature" \
        "^mobile/features/$feature/data/src/" "$feature"
done

# --- Compatibility adapter markers ------------------------------------------

compat_paths=$(tracked_mobile_files | grep -E '^mobile/(core|features)/' | grep -Ei 'compat[a-z]*(adapter|bridge|seam|alias)' || true)
[ -z "$compat_paths" ] || {
    printf '%s\n' "$compat_paths" >&2
    fail 'compatibility adapter path found after migration'
}

printf 'ok - mobile domain/data boundary\n'
