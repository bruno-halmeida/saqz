#!/bin/sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

fail() {
    printf 'design token gate failed: %s\n' "$1" >&2
    exit 1
}

# Ratchet: production feature UI must move toward SaqzTheme tokens instead of
# raw dp/hex values. The ceilings below are the violation counts measured on
# 2026-07-24; new code must not add raw values (swap-one-for-one still passes,
# which is an accepted ceiling of this check). When you remove raw values,
# lower the matching ceiling here so the gate keeps the progress.
# 258 -> 66 em 2026-07-24 (VUL-30): a apresentação de groups saiu com 192 dp cruas.
# 66 -> 24 em 2026-07-24 (VUL-37): pós-onda C todo o orçamento restante é do LoginScreen.kt.
# 24 -> 32 em 2026-07-24 (VUL-36): SaqzButton/SaqzInput vieram do :core:design-system
# apagado e trouxeram para dentro de features/ as dp cruas que já tinham lá.
raw_dp_ceiling=32
raw_color_ceiling=2

# O registro de tokens (access/ui/theme) é onde dp e hex são a definição, não uma
# violação — é ele que as telas devem consumir. Excluído da varredura desde que o
# :core:design-system foi apagado e o registro passou a morar dentro da feature (VUL-36).
feature_common_main() {
    find "$repository_root/mobile/features" -path '*/src/commonMain/*' -name '*.kt' \
        -not -path '*/build/*' -not -path '*/access/ui/theme/*'
}

raw_dp_count=$(feature_common_main | xargs grep -Eoh '[0-9]+\.dp' 2>/dev/null | wc -l | tr -d ' ')
raw_color_count=$(feature_common_main | xargs grep -Eh 'Color\(0x' 2>/dev/null | wc -l | tr -d ' ')

[ "$raw_dp_count" -le "$raw_dp_ceiling" ] ||
    fail "raw dp literals in mobile/features commonMain grew to $raw_dp_count (ceiling $raw_dp_ceiling); extraia a métrica para o tema da jornada em vez de fixar dp"

[ "$raw_color_count" -le "$raw_color_ceiling" ] ||
    fail "raw Color(0x...) literals in mobile/features commonMain grew to $raw_color_count (ceiling $raw_color_ceiling); extraia a cor para o tema da jornada em vez de fixar hex"

[ "$raw_dp_count" -eq "$raw_dp_ceiling" ] ||
    printf 'note: raw dp count is %s, below the ceiling of %s — lower raw_dp_ceiling in scripts/check-design-tokens to lock the progress\n' "$raw_dp_count" "$raw_dp_ceiling"

printf 'ok - design token gate (raw dp: %s/%s, raw colors: %s/%s)\n' "$raw_dp_count" "$raw_dp_ceiling" "$raw_color_count" "$raw_color_ceiling"
