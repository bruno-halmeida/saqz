meta {
  name: Read Invite Metadata
  type: http
  seq: 4
}

get {
  url: {{backendUrl}}/api/groups/{{groupId}}/invite
  body: none
  auth: bearer
}

auth:bearer {
  token: {{idToken}}
}

tests {
  test("any admin reads the same short code and url", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().active).to.equal(true);
    expect(res.getBody().code).to.match(/^[2-9A-HJKMNP-Z]{4}-[2-9A-HJKMNP-Z]{4}$/);
    expect(res.getBody().inviteUrl).to.contain("saqz_invite=" + res.getBody().code.replace("-", ""));
  });
}
