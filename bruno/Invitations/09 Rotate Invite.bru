meta {
  name: Rotate Invite
  type: http
  seq: 1
}

post {
  url: {{backendUrl}}/api/groups/{{groupId}}/invite
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{idToken}}
}

tests {
  test("rotation returns the new short code and the link that carries it", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().code).to.match(/^[2-9A-HJKMNP-Z]{4}-[2-9A-HJKMNP-Z]{4}$/);
    expect(res.getBody().inviteUrl).to.equal(
      "https://links.saqz.app/?saqz_invite=" + res.getBody().code.replace("-", "")
    );
  });
}
