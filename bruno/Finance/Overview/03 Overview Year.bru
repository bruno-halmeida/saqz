meta {
  name: Finance Overview by Year
  type: http
  seq: 3
}
get {
  url: {{baseUrl}}/api/me/finance/overview?year=2026
  body: none
  auth: bearer
}
auth:bearer { token: {{idToken}} }
tests {
  test("year period is returned", function () { expect(res.status).to.equal(200); expect(res.body.period.month).to.equal(null); expect(res.body.period.year).to.equal(2026); });
}
