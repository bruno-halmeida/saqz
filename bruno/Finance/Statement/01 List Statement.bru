meta {
  name: List Finance Statement
  type: http
  seq: 1
}
get {
  url: {{backendUrl}}/api/groups/{{groupId}}/finance/statement?limit=20&offset=0
  body: none
  auth: bearer
}
auth:bearer {
  token: {{idToken}}
}
tests {
  test("statement page and summary", function () { expect(res.status).to.equal(200); expect(res.body.items).to.be.an("array"); expect(res.body.summary).to.have.property("totalInCents"); expect(res.body.summary).to.have.property("totalOutCents"); expect(res.body.summary).to.have.property("accumulatedBalanceCents"); });
}
