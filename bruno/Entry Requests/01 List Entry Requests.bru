meta {
  name: List Entry Requests
  type: http
  seq: 1
}

get {
  url: {{backendUrl}}/api/groups/{{groupId}}/entry-requests
  body: none
  auth: bearer
}

auth:bearer {
  token: {{idToken}}
}

tests {
  test("returns pending entry requests", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an("array");
  });
}
