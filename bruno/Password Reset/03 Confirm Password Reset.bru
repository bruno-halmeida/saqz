meta {
  name: Confirm Password Reset (public)
  type: http
  seq: 3
}

post {
  url: {{backendUrl}}/api/password-reset/confirm
  body: json
  auth: none
}

body:json {
  {"token": "{{resetToken}}", "novaSenha": "{{newPassword}}"}
}

tests {
  test("password is updated", function () {
    expect([200, 204]).to.include(res.getStatus());
  });
}
