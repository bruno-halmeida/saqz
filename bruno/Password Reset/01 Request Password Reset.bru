meta {
  name: Request Password Reset (public)
  type: http
  seq: 1
}

post {
  url: {{backendUrl}}/api/password-reset/request
  body: json
  auth: none
}

body:json {
  {"email": "{{resetEmail}}"}
}

tests {
  test("reset request is accepted", function () {
    expect([200, 202, 204]).to.include(res.getStatus());
  });
}
