meta {
  name: Validate Coupon
  type: http
  seq: 2
}

post {
  url: {{backendUrl}}/coupons/validate
  body: json
  auth: bearer
}

auth:bearer {
  token: {{idToken}}
}

body:json {
  {"code": "{{couponCode}}", "planId": "{{planId}}", "cycle": "MONTHLY"}
}

tests {
  test("returns coupon validation result", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.be.a("string");
  });
}
