{
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "ui": {
      "enabled": false
    }
  },
  "hosting": {
    "target": "adm-web",
    "public": "adm-web",
    "ignore": ["**/.*", "**/README.md"],
    "headers": [
      {
        "source": "assets/**/*.@(woff2|ttf|png)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      },
      {
        "source": "assets/**/*.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
