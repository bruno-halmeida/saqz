# Gradle, Kotlin, and Android
.secrets
.gradle/
.kotlin/
**/build/
local.properties
.idea/
*.iml
captures/
.externalNativeBuild/
.cxx/

# Node tooling (Firebase CLI and session fixture)
node_modules/
dist/
coverage/

# Xcode and Swift Package Manager
DerivedData/
xcuserdata/
*.xcuserstate
.swiftpm/

# Firebase local runtime
.firebase/
firebase-debug.log*
ui-debug.log*
firebase-export-*/

# Local credentials and environment overrides
.env
.env.*
!.env.example
!.env.*.example
google-services.json
GoogleService-Info.plist
*.jks
*.keystore

# Bundle assinado que o "Generate Signed Bundle" do Android Studio grava em <módulo>/<flavor>/release.
mobile/android-app/prod/

# Operating systems
.DS_Store

# Local git worktrees
.worktrees/

# Evidência visual: os PNGs vivem na branch órfã `screenshots`, nunca na main.
# As tasks `recordRoborazzi*` regravam catálogos inteiros — versionar aqui é
# conflito binário garantido entre PRs paralelos.
mobile/**/screenshots/

# fastlane (CI das lojas mobile): relatório de execução gerado a cada run
mobile/fastlane/report.xml
mobile/fastlane/README.md

# Projetos de vídeo (HyperFrames): renders e node_modules passam de 1 GB e não são código do app.
videos/

# Identidade de pareamento que o go-ios (mobile-mcp no iPhone) grava na pasta de onde roda; tem chave privada.
selfIdentity.plist

# Lock do `npx skills`; as skills que ele instala em .agents/ já ficam fora do git.
skills-lock.json

# Saídas dos geradores de canvas (design/<tela>/gerar.py): o gerador recria tudo, então não vão ao GitHub.
design/*/previa/
design/*/project/
